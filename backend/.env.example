# Copy to backend/.env. Never commit the real token.
EARCEO_API_TOKEN=replace-with-a-long-random-development-token
EARCEO_PROJECTS={"adventurex-demo":"/absolute/path/to/a/disposable/demo/repository"}
EARCEO_BACKEND=mock
# Optional: slow mock events for restart/reconnect/cancellation device tests.
EARCEO_MOCK_DELAY_SECONDS=0
# Optional server-owned pre-dispatch approval policy. R0/R1 dispatch normally,
# R2 requires an approve/reject decision, and R3 can only be rejected.
EARCEO_APPROVAL_RISKS={}
EARCEO_APPROVAL_TTL_SECONDS=600
CODING_VIBE_STATE_DIR=.state

# Existing Web API compatibility and subprocess safety.
CV_ALLOWED_BACKENDS=mock
CV_ALLOWED_REPO_ROOTS=/tmp
